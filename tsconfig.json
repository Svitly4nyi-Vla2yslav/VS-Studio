{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": false
  },
  "include": ["src", "webpack.config.ts", "netlify/functions/**/*"],
  "exclude": [
    "src/pages/OvenKitchenAid/**",
    "src/pages/OvenRepair/**",
    "src/pages/OvenThermador/**",
    "src/pages/OvenViking/**",
    "src/pages/OvenWolf/**",
    "src/pages/Refrigeration/**",
    "src/pages/RefrigeratorGEMonogram/**",
    "src/pages/RefrigeratorKitchenAid/**",
    "src/pages/RefrigeratorSubZero/**",
    "src/pages/RefrigeratorThermador/**",
    "src/pages/RefrigeratorViking/**"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
